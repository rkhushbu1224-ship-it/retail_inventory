# Khushbu Electronic Store - Environment Configuration Example
# Stack: Next.js (React) + Node.js (Express) + MongoDB + JWT Authentication

# Backend Server Configuration
PORT=8081

# Database Configuration (MongoDB)
# Local MongoDB or MongoDB Atlas URI:
MONGODB_URI=mongodb://127.0.0.1:27017/khushbu_electronic_store

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# Frontend API Endpoint
VITE_API_URL=http://localhost:8081
NEXT_PUBLIC_API_URL=http://localhost:8081

# Optional AI / Gemini Studio Integration
GEMINI_API_KEY=your_gemini_api_key_here
